{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "npm run *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "npx oxlint *": "allow",
      "npx oxfmt *": "allow",
      "npx playwright *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.databasedumps": "deny",
      "*.sqz": "deny",
      "*.qz": "deny"
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest"]
}
