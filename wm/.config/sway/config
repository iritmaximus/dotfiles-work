    xkb_layout arkkudvorak,us
    xkb_variant ,colemak,
    xkb_options grp:win_space_toggle,caps:swapescape
    # xkb_options grp:win_space_toggle,caps:ctrl_modifier
}

input "1118:2045:Microsoft_Microsoft_Nano_Transceiver_1.1" {
